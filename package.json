{
  "name": "@le-space/orbitdb-storage-bridge",
  "version": "0.11.0",
  "description": "Back up, restore and replicate OrbitDB databases through pluggable storage backends, with hash and identity preservation",
  "main": "lib/orbitdb-storacha-bridge.js",
  "svelte": "dist/components/",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/orbitdb-storacha-bridge.d.ts",
      "default": "./lib/orbitdb-storacha-bridge.js"
    },
    "./backup-car": "./lib/backup-car.js",
    "./courier-sync": "./lib/courier-sync.js",
    "./pointer-ipns": "./lib/pointer-ipns.js",
    "./dehydrate": "./lib/dehydrate.js",
    "./restore-cid": "./lib/restore-cid.js",
    "./gateway-fetch": "./lib/gateway-fetch.js",
    "./backends/types": "./lib/backends/types.js",
    "./backends/memory": "./lib/backends/memory.js",
    "./backends/storacha": "./lib/backends/storacha.js",
    "./backends/aleph": "./lib/backends/aleph.js",
    "./backends/aleph-pin": "./lib/backends/aleph-pin.js",
    "./backends/pinata": "./lib/backends/pinata.js",
    "./backends/lighthouse": "./lib/backends/lighthouse.js",
    "./backends/mirror": "./lib/backends/mirror.js",
    "./backends/choose": "./lib/backends/choose.js",
    "./backends/resolve": "./lib/backends/resolve.js",
    "./memory-courier": "./lib/memory-courier.js",
    "./StorachaIntegration.svelte": "./dist/components/StorachaIntegration.svelte",
    "./StorachaAuth.svelte": "./dist/components/StorachaAuth.svelte",
    "./storacha-backup": "./dist/components/storacha-backup.js",
    "./components/*": "./dist/components/*"
  },
  "scripts": {
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest",
    "test:verbose": "npm test -- --verbose",
    "test:integration": "npm test -- test/integration.test.js",
    "test:p256-ucan": "npm test -- test/p256-ucan-security.test.js",
    "test:car-backup": "npm test -- test/backup-car.test.js",
    "test:timestamped-backup": "npm test -- test/timestamped-backup.test.js",
    "test:network-download": "npm test -- test/network-download.test.js",
    "test:backends": "npm test -- test/backends/",
    "clear-space": "node examples/storacha/clear-space.js",
    "car-demo": "node examples/storacha/car-backup-demo.js",
    "ucan-demo": "node examples/storacha/ucan-demo.js",
    "lint": "eslint --config eslint.config.js '{lib,examples,test}/**/*.js' --ignore-pattern 'examples/svelte/*/build/**' --ignore-pattern 'examples/svelte/*/dist/**' --ignore-pattern 'examples/svelte/**/.svelte-kit/**' --ignore-pattern 'node_modules/**'",
    "format": "prettier --write lib/ examples/ test/ --ignore-path '.prettierignore'",
    "clean": "rm -rf ./cid-bridge-test* ./demo-test*",
    "build:components": "mkdir -p dist/components && cp src/components/*.svelte dist/components/ && cp src/components/*.js dist/components/",
    "prepublishOnly": "npm run build:components"
  },
  "keywords": [
    "orbitdb",
    "storacha",
    "filecoin",
    "ipfs",
    "backup",
    "replication",
    "web3",
    "decentralized",
    "database",
    "cid",
    "bridge",
    "storage",
    "restore",
    "car",
    "aleph",
    "pinata",
    "local-first"
  ],
  "files": [
    "lib",
    "dist",
    "!dist/components/StorachaTest.svelte",
    "!dist/components/StorachaTestWithReplication.svelte",
    "!dist/components/StorachaTestWithWebAuthn.svelte",
    "README.md",
    "LICENSE"
  ],
  "author": "OrbitDB Storage Bridge Contributors",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@helia/block-brokers": "^5.2.4",
    "@helia/routers": "^5.1.1",
    "@helia/unixfs": "^8.0.7",
    "@ipld/car": "^5.4.1",
    "@ipld/dag-cbor": "^9.0.6",
    "@ipld/dag-ucan": "^3.4.5",
    "@libp2p/bootstrap": "^12.0.27",
    "@libp2p/crypto": "^5.1.21",
    "@libp2p/gossipsub": "^16.1.0",
    "@libp2p/identify": "^4.1.10",
    "@libp2p/kad-dht": "^16.4.5",
    "@libp2p/logger": "^6.2.13",
    "@libp2p/ping": "^3.1.9",
    "@libp2p/tcp": "^11.0.28",
    "@orbitdb/core": "^4.0.0",
    "@scure/bip39": "^1.3.0",
    "@storacha/capabilities": "^2.0.0",
    "@storacha/client": "^2.0.0",
    "blockstore-level": "^4.0.1",
    "cbor-web": "^10.0.11",
    "datastore-level": "^13.0.1",
    "dotenv": "^17.2.1",
    "helia": "^7.1.12",
    "libp2p": "^3.3.6",
    "multiformats": "^14.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ibm/plex": "^6.4.1",
    "@jest/globals": "^30.5.1",
    "@le-space/ucanto-principal": "^9.1.1",
    "@libp2p/websockets": "^10.1.17",
    "@orbitdb/identity-provider-did": "^1.0.2",
    "@storacha/did-mailto": "^1.0.1",
    "@storacha/upload-api": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@ucanto/client": "^9.0.2",
    "@ucanto/core": "^10.4.0",
    "@ucanto/principal": "^9.0.2",
    "@ucanto/server": "^11.0.3",
    "@ucanto/transport": "^9.2.1",
    "@web3-storage/sigv4": "^1.0.2",
    "carbon-components-svelte": "^0.89.7",
    "carbon-icons-svelte": "^12.17.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "key-did-provider-ed25519": "^4.0.2",
    "key-did-resolver": "^4.0.0",
    "prettier": "^3.0.3",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.7.0"
  },
  "peerDependencies": {
    "lucide-svelte": ">=0.400.0 <1.0.0",
    "svelte": "^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NiKrause/orbitdb-storage-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/NiKrause/orbitdb-storage-bridge/issues"
  },
  "homepage": "https://github.com/NiKrause/orbitdb-storage-bridge#readme",
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "verbose": true,
    "passWithNoTests": true,
    "maxWorkers": 1,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/examples/",
      "/dist/",
      "/coverage/"
    ],
    "moduleNameMapper": {
      "^@peculiar/webcrypto$": "<rootDir>/node_modules/@peculiar/webcrypto/build/webcrypto.js"
    }
  },
  "overrides": {
    "test-exclude": "^8.0.0"
  }
}
